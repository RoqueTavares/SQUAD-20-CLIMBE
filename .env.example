# =============================================================================
# Sistema Climbe - Template de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Spring profile ativo
# Controla beans anotados com @Profile (ex.: initDataSeeder do CEO admin).
# Em dev local (docker-compose), mantenha 'dev'.
# Em staging/produção, sobrescreva para 'prod' (ou outro) no orquestrador.
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# JWT
# Gere um secret aleatório forte (mínimo 64 chars, base64 recomendado):
#   openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Banco de dados (alinhado ao serviço db do docker-compose.yml)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/user_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# -----------------------------------------------------------------------------
# RabbitMQ (alinhado ao serviço rabbitmq do docker-compose.yml)
# Management UI: http://localhost:15672 (admin/admin)
# Em staging/prod, gere usuário/senha próprios no broker e nunca use admin/admin.
# -----------------------------------------------------------------------------
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=admin

# -----------------------------------------------------------------------------
# WebSocket broker relay
# Local/teste pode ficar false para usar SimpleBroker em memória.
# Para escala horizontal, habilite true e aponte para RabbitMQ com plugin STOMP.
# -----------------------------------------------------------------------------
APP_WEBSOCKET_BROKER_RELAY_ENABLED=false
APP_WEBSOCKET_BROKER_RELAY_HOST=rabbitmq
APP_WEBSOCKET_BROKER_RELAY_PORT=61613
APP_WEBSOCKET_BROKER_RELAY_CLIENT_LOGIN=admin
APP_WEBSOCKET_BROKER_RELAY_CLIENT_PASSCODE=admin
APP_WEBSOCKET_BROKER_RELAY_SYSTEM_LOGIN=admin
APP_WEBSOCKET_BROKER_RELAY_SYSTEM_PASSCODE=admin
APP_WEBSOCKET_BROKER_RELAY_VIRTUAL_HOST=/
APP_WEBSOCKET_BROKER_RELAY_USER_DESTINATION_BROADCAST=/topic/unresolved-user-destinations
APP_WEBSOCKET_BROKER_RELAY_USER_REGISTRY_BROADCAST=/topic/simp-user-registry
APP_WEBSOCKET_BROKER_RELAY_SYSTEM_HEARTBEAT_SEND_INTERVAL=10000
APP_WEBSOCKET_BROKER_RELAY_SYSTEM_HEARTBEAT_RECEIVE_INTERVAL=10000

# -----------------------------------------------------------------------------
# Google OAuth2
# Obter em: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# -----------------------------------------------------------------------------
# Google Cloud Storage
# JSON da service account: salvar em src/main/resources/gcp-credentials.json
# (já está no .gitignore)
# -----------------------------------------------------------------------------
GCP_CREDENTIALS_FILE_PATH=classpath:gcp-credentials.json
GCP_BUCKET_NAME=

# -----------------------------------------------------------------------------
# SMTP
# Sugestão para dev: Mailtrap (https://mailtrap.io) ou MailHog local.
# -----------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# CORS - origens permitidas (frontend), separadas por vírgula
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend / OAuth redirect
# Em staging/prod, use a URL HTTPS do frontend.
# -----------------------------------------------------------------------------
APP_FRONTEND_REDIRECT_URL=http://localhost:5173/dashboard

# -----------------------------------------------------------------------------
# Cookies de autenticação
# Em staging/prod com HTTPS:
#   APP_COOKIE_SECURE=true
#   APP_COOKIE_SAME_SITE=None se frontend e API ficarem em domínios diferentes.
#   APP_COOKIE_SAME_SITE=Lax se ficarem no mesmo site.
# -----------------------------------------------------------------------------
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
APP_COOKIE_ACCESS_TOKEN_MAX_AGE_SECONDS=1800
APP_COOKIE_REFRESH_TOKEN_MAX_AGE_SECONDS=604800

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Cloud Run injeta PORT automaticamente. Em local, SERVER_PORT continua suficiente.
PORT=8080
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# -----------------------------------------------------------------------------
# Actuator / healthcheck
# -----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_MAIL_ENABLED=false
