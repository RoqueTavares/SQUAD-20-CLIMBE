# =============================================================================
# Sistema Climbe - Template de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# JWT
# Gere um secret aleatório forte (mínimo 64 chars, base64 recomendado):
#   openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Banco de dados (alinhado ao serviço db do docker-compose.yml)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/user_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# -----------------------------------------------------------------------------
# RabbitMQ (alinhado ao serviço rabbitmq do docker-compose.yml)
# Management UI: http://localhost:15672 (admin/admin)
# -----------------------------------------------------------------------------
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=admin

# -----------------------------------------------------------------------------
# Google OAuth2
# Obter em: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# -----------------------------------------------------------------------------
# Google Cloud Storage
# JSON da service account: salvar em src/main/resources/gcp-credentials.json
# (já está no .gitignore)
# -----------------------------------------------------------------------------
GCP_CREDENTIALS_FILE_PATH=classpath:gcp-credentials.json
GCP_BUCKET_NAME=

# -----------------------------------------------------------------------------
# SMTP
# Sugestão para dev: Mailtrap (https://mailtrap.io) ou MailHog local.
# -----------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# CORS - origens permitidas (frontend), separadas por vírgula
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_PORT=8080
